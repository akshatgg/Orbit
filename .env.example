# ─────────────────────────────────────────────────────────────
# ORBIT environment variables
# Copy to .env.local and fill in. Never commit .env.local.
#
# The app talks only to the Orbit API (FastAPI). Accounts, data, email, web push,
# payments (Stripe), image uploads (Cloudinary) and the event importers all live
# there, so their secrets are set on the API, not here.
# ─────────────────────────────────────────────────────────────

# Orbit API, called from the server (Server Components, Actions, Route Handlers).
# Production: https://orbit-back.akshatgg.in
BACKEND_URL=http://localhost:8090

# The same API as the browser reaches it: Google sign-in redirects, the email
# login-link request and the dev password sign-in. Production: https://orbit-back.akshatgg.in
NEXT_PUBLIC_BACKEND_URL=http://localhost:8090

# Public URL of the app (https://orbit.akshatgg.in in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SEO: Google Search Console "HTML tag" verification. Paste only the content="…" value of the
# google-site-verification meta tag. Leave empty if you verify with a DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=

# Web push: the API's VAPID public key (the private key stays on the API).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Vercel Cron calls /api/cron/* with `Authorization: Bearer $CRON_SECRET`; the app forwards
# the call to the API, which must have the same CRON_SECRET.
CRON_SECRET=

# Local development only: shows an email + password sign-in on /login (POST /auth/login).
# Never set in production.
# NEXT_PUBLIC_DEV_LOGIN=1
